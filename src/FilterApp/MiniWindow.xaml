<Window x:Class="FilterApp.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, StringFormat='Bandeja — {0}'}" Icon="app.ico" Width="240" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
        MouseLeftButtonDown="OnMouseDown">
  <Border x:Name="Frame" CornerRadius="12" Background="#F9FAFB" BorderBrush="#AFB8C1" BorderThickness="1.5" Margin="6">
    <Border.Effect>
      <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
    </Border.Effect>
    <Grid>
      <Rectangle x:Name="Dashes" Margin="8" RadiusX="8" RadiusY="8" Stroke="#AFB8C1" StrokeThickness="1.5" StrokeDashArray="4 3"/>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock x:Name="StateIcon" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="#0969DA"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="Headline" Text="Suelta archivos aquí" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,2"/>
        <TextBlock HorizontalAlignment="Center" Foreground="#57606A" FontSize="12">
          <Run Text="{Binding Pending.Count, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" en Pendientes"/>
        </TextBlock>
      </StackPanel>
      <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Style="{StaticResource IconButton}"
              Content="&#xE740;" Click="OnExpand" ToolTip="Volver a la ventana completa (o doble clic)"/>
    </Grid>
  </Border>
</Window>
