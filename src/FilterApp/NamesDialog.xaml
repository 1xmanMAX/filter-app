<Window x:Class="FilterApp.NamesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FilterApp"
        Title="Agregar carpetas y nombres" Width="820" Height="600" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="14" Background="#F4F5F7">
  <DockPanel Margin="16">
    <TextBlock x:Name="Where" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#57606A" Margin="0,0,0,10" FontSize="13">
      Escribe o pega un nombre por línea. Pulsa <Bold>Tab</Bold> para meter una línea dentro de la de arriba
      (<Bold>Shift+Tab</Bold> la saca): la línea que tiene cosas dentro se vuelve <Bold>carpeta</Bold> sola.
    </TextBlock>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Click="OnCopyStructure"
              ToolTip="Agrega las subcarpetas (no los archivos) de una carpeta que ya tengas, para repetir su orden">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock Text="Copiar estructura de una carpeta…" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource FlatButton}" Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/>
        <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Content="Agregar" Click="OnOk"/>
      </StackPanel>
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
      <TextBlock Text="Las líneas sin nada dentro son:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#57606A"/>
      <RadioButton x:Name="LeavesNames" Content="nombres de archivo" IsChecked="True" VerticalContentAlignment="Center"
                   Margin="0,0,14,0" Checked="OnModeChanged"/>
      <RadioButton x:Name="LeavesFolders" Content="carpetas" VerticalContentAlignment="Center" Checked="OnModeChanged"/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="Box" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" Padding="6" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                 TextChanged="OnTextChanged" PreviewKeyDown="OnBoxKeyDown"/>
        <TextBlock x:Name="Example" IsHitTestVisible="False" Margin="10,8" Foreground="#A0A7AF" FontFamily="Cascadia Mono, Consolas"
                   FontSize="13" Text="Clientes&#x0a;    Juan Perez&#x0a;        DNI&#x0a;        Contrato&#x0a;    Ana Lopez&#x0a;Facturas 2026"/>
      </Grid>
      <Border Grid.Column="2" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4">
        <DockPanel>
          <TextBlock x:Name="Summary" DockPanel.Dock="Top" Margin="10,8" FontSize="12" Foreground="#57606A" Text="Así quedará"/>
          <TreeView x:Name="Tree" BorderThickness="0" Margin="4,0,4,4">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="True"/>
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate DataType="{x:Type local:PlanNode}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                  <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{Binding IconColor}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding Name}"/>
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
