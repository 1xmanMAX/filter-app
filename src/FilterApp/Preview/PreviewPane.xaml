<UserControl x:Class="FilterApp.Preview.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="White" CornerRadius="8" BorderBrush="#D0D7DE" BorderThickness="1">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="12,8,8,8">
        <Button x:Name="OpenButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="10,4"
                VerticalAlignment="Center" Click="OnOpen" IsEnabled="False"
                ToolTip="Abrir con su programa (también: doble clic en el archivo)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Abrir" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock x:Name="Title" Text="VISTA PREVIA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="Details" FontSize="12" Foreground="#57606A" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
      <Grid ClipToBounds="True" Background="#FAFBFC">
        <TextBlock x:Name="Message" Text="Selecciona un archivo para verlo aquí" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="24" VerticalAlignment="Center" Foreground="#8C959F"/>
        <Image x:Name="ImageView" Stretch="Uniform" StretchDirection="DownOnly" Margin="8" Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBox x:Name="TextView" IsReadOnly="True" BorderThickness="0" Padding="10" Visibility="Collapsed"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="White"/>
        <ContentControl x:Name="WebSlot" Visibility="Collapsed"/>
        <ContentControl x:Name="HandlerSlot" Visibility="Collapsed"/>
        <StackPanel x:Name="Fallback" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="Collapsed">
          <Image x:Name="Thumb" MaxWidth="200" MaxHeight="200" Margin="0,0,0,12"/>
          <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="#57606A"
                     Text="Sin vista previa para este tipo de archivo.&#x0a;Doble clic o «Abrir» para verlo con su programa."/>
        </StackPanel>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
