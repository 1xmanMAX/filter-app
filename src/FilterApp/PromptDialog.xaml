<Window x:Class="FilterApp.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="14" Background="#F4F5F7">
  <StackPanel Margin="16">
    <TextBlock x:Name="Label" Margin="0,0,0,8"/>
    <TextBox x:Name="Box" Padding="6"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Style="{StaticResource FlatButton}" Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="Ok" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</Window>
