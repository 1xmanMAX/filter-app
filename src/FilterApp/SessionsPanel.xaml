<UserControl x:Class="FilterApp.SessionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FilterApp"
             FontFamily="Segoe UI" FontSize="14" PreviewKeyDown="OnPreviewKeyDown">
  <UserControl.Resources>
    <Style x:Key="Progress" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Foreground" Value="#2DA44E"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="#EAEEF2"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}"
                      HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- Margin leaves room for the shadow inside the transparent popup -->
  <Border Margin="10,6,10,14" Width="360" Background="White" CornerRadius="10" BorderBrush="#D0D7DE" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.16"/>
    </Border.Effect>
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="12,5" Click="OnNewClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Nueva" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <TextBlock Text="SESIONES" FontSize="11" FontWeight="SemiBold" Foreground="#57606A" VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Inline name box for a new session -->
      <Border x:Name="NewBox" DockPanel.Dock="Top" Visibility="Collapsed" Margin="12,0,12,8"
              BorderBrush="#0969DA" BorderThickness="2" CornerRadius="6" Background="White">
        <Grid>
          <TextBox x:Name="NewName" BorderThickness="0" Padding="8,6" Background="Transparent" KeyDown="OnNewNameKeyDown"/>
          <TextBlock Text="Nombre de la nueva sesión y Enter" Margin="11,7,0,0" Foreground="#8C959F" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text.Length, ElementName=NewName}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>

      <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="List" Margin="8,0,8,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:SessionRow}">
              <Border x:Name="Row" Margin="0,2" Padding="12,9,8,10" CornerRadius="8" Background="Transparent"
                      Cursor="Hand" MouseLeftButtonUp="OnRowClick" ToolTip="Abrir esta sesión">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Accent" Width="3" CornerRadius="2" Margin="-6,0,9,0" Background="#0969DA" Visibility="Collapsed"/>
                  <StackPanel Grid.Column="1">
                    <DockPanel>
                      <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Hidden" Margin="4,-4,0,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Renombrar" Click="OnRenameClick"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Eliminar" Click="OnDeleteClick"/>
                      </StackPanel>
                      <Border x:Name="Chip" DockPanel.Dock="Right" CornerRadius="9" Padding="7,1" Margin="6,0,0,0"
                              VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="ChipText" FontSize="10.5" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" Foreground="#24292F"/>
                    </DockPanel>
                    <ProgressBar Style="{StaticResource Progress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,6"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#57606A"/>
                  </StackPanel>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                  <Setter TargetName="Chip" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="Chip" Property="Background" Value="#DAFBE1"/>
                  <Setter TargetName="ChipText" Property="Text" Value="✔ COMPLETA"/>
                  <Setter TargetName="ChipText" Property="Foreground" Value="#1A7F37"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#F0F6FF"/>
                  <Setter TargetName="Row" Property="ToolTip" Value="Sesión abierta"/>
                  <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="Chip" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="Chip" Property="Background" Value="#DDF4FF"/>
                  <Setter TargetName="ChipText" Property="Text" Value="ABIERTA"/>
                  <Setter TargetName="ChipText" Property="Foreground" Value="#0969DA"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                </Trigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsCurrent}" Value="False"/>
                    <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True"/>
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="Row" Property="Background" Value="#F6F8FA"/>
                </MultiDataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
